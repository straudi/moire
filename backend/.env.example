# backend/.env 로 복사해서 사용합니다. .env는 Git에 올리지 않습니다.
# 비워 두면 더미 모드로 동작합니다.

# auto: BEDROCK_MODEL_ID가 있으면 Bedrock 호출, 없으면 더미 / dummy: 항상 더미
AI_MODE=auto
AWS_REGION=us-east-1
# 계정·리전에서 실제 호출 가능한 모델 ID를 확인한 뒤 적습니다. (예시 값을 확정값으로 쓰지 않음)
BEDROCK_MODEL_ID=
# AWS 자격 증명은 표준 체인(환경변수 AWS_ACCESS_KEY_ID 등, ~/.aws, 실행 역할)을 사용합니다.

OPENWEATHER_API_KEY=

# 화면 주소. 여러 개는 쉼표로 구분
ALLOWED_ORIGINS=http://localhost:3000
